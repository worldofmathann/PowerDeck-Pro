{
  "name": "powerdeckpro",
  "version": "2.0.1",
  "description": "PowerDeck Pro - Advanced Clubhouse Auth & Agora Audio Engine with Themed Interface",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "protect": "node scripts/protect-and-build.js",
    "build:protected": "node scripts/protect-and-build.js --build",
    "build:exe": "electron-builder --win",
    "build:portable": "electron-builder --win portable",
    "build:dir": "electron-builder --dir",
    "rust:build": "cargo build --release --manifest-path rust-core/Cargo.toml",
    "test": "echo \"No test specified\" && exit 0"
  },
  "keywords": [
    "clubhouse",
    "powerdeck",
    "agora",
    "auth",
    "electron",
    "rust"
  ],
  "author": "worldofmathann",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/worldofmathann/PowerDeck-Pro.git"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "^26.18.0",
    "javascript-obfuscator": "^4.2.2"
  },
  "dependencies": {
    "agora-rtc-sdk-ng": "^4.24.9",
    "bytenode": "^1.7.0",
    "pubnub": "^13.1.3"
  },
  "build": {
    "appId": "com.powerdeck.app",
    "productName": "PowerDeck Pro",
    "copyright": "Copyright © 2026 PowerDeck Pro Team",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "${productName} Portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PowerDeck Pro",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  }
}
